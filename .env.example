# --- Database (Supabase Postgres) ---
# Copy both from Supabase: Project Settings -> Database.
#
# Pooled connection (transaction mode, port 6543): used by the app at runtime.
# "pgbouncer=true" is required with the pooler (it does not support prepared
# statements); "connection_limit=1" suits serverless functions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432): used only by `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Session ---
# Exactly 64 hex characters. Generate with: openssl rand -hex 32
# Use a DIFFERENT value for every environment (local, preview, production).
SESSION_SECRET=

# --- Rate limiting (Upstash Redis) ---
# Without these, limits are kept per server instance only, which does not work
# across serverless instances. Create a free Redis database at upstash.com and
# copy the REST URL and token. (Vercel's Upstash integration sets the
# KV_REST_API_URL / KV_REST_API_TOKEN pair instead; either pair works.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public site URL ---
# Include the scheme. Used for the sitemap, robots.txt and social metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
